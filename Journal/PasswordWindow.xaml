<Window x:Class="Journal.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Password" Height="220" Width="400"
        Icon="/diary.png"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Background="#FF3C3030"
        KeyDown="Window_KeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="InfoTextBlock"
           Text="Please enter the password"
           FontSize="16" 
           VerticalAlignment="Center" 
           Margin="0,0,0,10" 
           Foreground="White"/>


        <PasswordBox x:Name="PasswordBox" 
                     Grid.Row="1"
                     FontSize="16" 
                     Background="#FF231D1D"/>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,0">
            <Button x:Name="SubmitButton" Content="Unlock" 
                Grid.Row="2" 
                Margin="0,10,20,0"
                Width="95" Height="35" 
                HorizontalAlignment="Right"
                Click="SubmitButton_Click"/>

            <Button x:Name="ChangePasswordButton" Content="Change Password" 
                Grid.Row="3"
                Margin="0,10,0,0"
                Width="150" Height="35"
                HorizontalAlignment="Left"
                Click="ChangePasswordButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
