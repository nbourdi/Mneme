<Window x:Class="Journal.NewPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set New Password" Height="260" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#FF3C3030">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Label "Enter new password" -->
            <RowDefinition Height="Auto"/>
            <!-- New PasswordBox -->
            <RowDefinition Height="Auto"/>
            <!-- Label "Confirm new password" -->
            <RowDefinition Height="Auto"/>
            <!-- Confirm PasswordBox -->
            <RowDefinition Height="Auto"/>
            <!-- Button -->
        </Grid.RowDefinitions>

        <TextBlock Text="Enter new password" 
                   FontSize="16" 
                   Foreground="White"
                   Margin="0,0,0,5"/>

        <PasswordBox x:Name="NewPasswordBox"
                     Grid.Row="1" 
                     FontSize="16"
                     Background="#FF231D1D"
                     Margin="0,0,0,10"/>


        <PasswordBox x:Name="ConfirmPasswordBox"
                     Grid.Row="3"
                     FontSize="16"
                     Background="#FF231D1D"
                     Margin="0,0,0,10"/>

        <Button Content="Save" 
                Grid.Row="4" 
                Margin="0,20,0,0"
                Width="100" Height="30" 
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="SaveButton_Click"/>
    </Grid>

</Window>
