<Window x:Class="Journal.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Journal"
        mc:Ignorable="d"
        Title="Journal" Height="600" Width="800">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FFDDDDDD"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#FFAAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Style for all TextBoxes -->
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Style for all Labels -->
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="DarkSlateGray"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Style for ListBox -->
        <Style TargetType="ListBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <Grid Margin="0,0,0,-6" Background="#FFFFF8F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Entry Title -->
        <TextBox x:Name="TitleTextBox"
                 HorizontalAlignment="Left" Margin="50,49,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Height="61" Width="498"
                 Background="#FFFFF8F8"
                 BorderBrush="{x:Null}"
                 Text="Title"/>

        <!-- Entry Content -->
        <TextBox x:Name="ContentTextBox"
                 HorizontalAlignment="Left" Margin="50,147,0,0"
                 TextWrapping="Wrap"
                 VerticalAlignment="Top"
                 Width="498" Height="373"
                 BorderBrush="{x:Null}"
                 AcceptsReturn="True"
                 Text=""/>

        <!-- Save Button -->
        <Button x:Name="SaveButton"
                Content="Save Entry"
                HorizontalAlignment="Left"
                Margin="463,538,0,0"
                VerticalAlignment="Top"
                Click="SaveButton_Click"/>

        <!-- Entry List -->
        <ListBox x:Name="EntriesListBox"
                 Margin="580,80,0,0"
                 SelectionChanged="EntriesListBox_SelectionChanged"/>

        <!-- Past Entries Label -->
        <Label Content="Past Entries"
               HorizontalAlignment="Left"
               Height="29"
               Margin="581,29,0,0"
               VerticalAlignment="Top"
               Width="129"/>

        <!-- New Entry Button -->
        <Button x:Name="NewEntryButton"
                Content="New Entry"
                HorizontalAlignment="Center"
                Margin="0,539,0,0"
                VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0.5"
                Background="#FFFFF4D2"
                BorderBrush="#00000000"
                FontFamily="Bahnschrift SemiBold"
                Click="NewEntryButton_Click"/>

        <!-- Instruction Label -->
        <Label Content="How was your day?"
               HorizontalAlignment="Left"
               Margin="50,110,0,0"
               VerticalAlignment="Top"
               FontSize="12"
               FontWeight="Normal"
               FontStyle="Italic"/>
    </Grid>
</Window>
